{
  "name": "soletrade",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Soletrade - one workspace to run your business.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.3.0 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "pnpm --filter @soletrade/web dev",
    "dev:all": "turbo run dev",
    "start": "pnpm --filter @soletrade/web start",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:root && pnpm architecture:check",
    "lint:root": "eslint scripts eslint.config.mjs",
    "lint:fix": "turbo run lint:fix && eslint scripts eslint.config.mjs --fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:ci": "turbo run test --concurrency=1",
    "test:watch": "pnpm --filter @soletrade/web test:watch",
    "test:integration": "pnpm --filter @soletrade/web test:integration",
    "test:stripe": "pnpm --filter @soletrade/web test:stripe",
    "test:e2e": "pnpm --filter @soletrade/web test:e2e",
    "test:e2e:ui": "pnpm --filter @soletrade/web test:e2e:ui",
    "test:e2e:ci": "pnpm --filter @soletrade/web test:e2e:ci",
    "mobile:dev": "pnpm --filter @soletrade/mobile dev",
    "mobile:type-check": "pnpm --filter @soletrade/mobile type-check",
    "mobile:test": "pnpm --filter @soletrade/mobile test",
    "mobile:export": "pnpm --filter @soletrade/mobile export",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm type-check && pnpm test:ci && pnpm format:check && pnpm branding:check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types types --local --lang=typescript > apps/web/src/server/infrastructure/db/types.ts",
    "stripe:setup": "pnpm --filter @soletrade/web stripe:setup",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhooks",
    "branding:check": "node --import tsx scripts/check-branding.ts",
    "icons:generate": "pnpm --filter @soletrade/web icons:generate",
    "architecture:check": "node packages/eslint-config/cycles.mjs apps/web apps/mobile packages/contracts"
  },
  "devDependencies": {
    "@soletrade/eslint-config": "workspace:*",
    "eslint": "^9",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "turbo": "^2.11.10"
  }
}
