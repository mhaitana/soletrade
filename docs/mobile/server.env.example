# Merge these optional values into the existing server environment.
# Keep private keys on the Next.js server. Never use EXPO_PUBLIC_ for secrets.

MOBILE_BUNDLE_ID=au.com.soletrade.business
MOBILE_STORE_PURCHASES_ENABLED=false

# App Store Server API. Use Sandbox for local/store sandbox verification.
APPLE_STORE_ENVIRONMENT=Sandbox
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# JSON array of base64 DER Apple root CA certificates from Apple's PKI source.
APPLE_ROOT_CERTIFICATES_BASE64=[]

# Play Developer API and authenticated Pub/Sub push subscription.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_NOTIFICATION_EMAIL=
GOOGLE_PLAY_NOTIFICATION_AUDIENCE=

# Optional Expo Push Service access token; provision APNs/FCM through the native project.
EXPO_ACCESS_TOKEN=
# Existing CRON_SECRET protects /api/cron/mobile. Schedule it every minute.
