# ─────────────────────────────────────────────────────────────
# Soletrade — environment variables
# Copy to .env.local and fill in. Server secrets are optional for
# local dev (the app boots with defaults); modules assert their
# own required secrets at their boundary.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public-facing URLs — the production app domain is never hard-coded in code.
# marketing defaults to https://www.soletrade.example; support/privacy/terms default to
# ${NEXT_PUBLIC_APP_URL}/support|privacy|terms (the legal pages live on the app domain).
# Set the *_URL vars below only to host a page somewhere else.
NEXT_PUBLIC_MARKETING_URL=https://www.soletrade.example
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=

# Supabase (auth + storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Drizzle — Supabase pooled connection)
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price ids — created by `pnpm stripe:setup`, paste the printed ids here.
# 16 prices: 4 modules × standalone/add-on × monthly/annual. The anchor app
# (highest-standalone-price active module) is billed standalone; the rest are
# add-ons (flat $2.50/mo / $22.50/yr off standalone).
STRIPE_PRICE_BOOKS_STANDALONE_MONTHLY=
STRIPE_PRICE_BOOKS_STANDALONE_ANNUAL=
STRIPE_PRICE_BOOKS_ADDON_MONTHLY=
STRIPE_PRICE_BOOKS_ADDON_ANNUAL=
STRIPE_PRICE_QUOTES_STANDALONE_MONTHLY=
STRIPE_PRICE_QUOTES_STANDALONE_ANNUAL=
STRIPE_PRICE_QUOTES_ADDON_MONTHLY=
STRIPE_PRICE_QUOTES_ADDON_ANNUAL=
STRIPE_PRICE_DRIVE_STANDALONE_MONTHLY=
STRIPE_PRICE_DRIVE_STANDALONE_ANNUAL=
STRIPE_PRICE_DRIVE_ADDON_MONTHLY=
STRIPE_PRICE_DRIVE_ADDON_ANNUAL=
STRIPE_PRICE_INVOICES_STANDALONE_MONTHLY=
STRIPE_PRICE_INVOICES_STANDALONE_ANNUAL=
STRIPE_PRICE_INVOICES_ADDON_MONTHLY=
STRIPE_PRICE_INVOICES_ADDON_ANNUAL=

# Cron — shared bearer secret for /api/cron/invoice-overdue and /api/cron/quote-expired.
# Vercel Cron sends it as `Authorization: Bearer <secret>`. Generate a strong random string.
CRON_SECRET=

# Email (Resend)
RESEND_API_KEY=
# Bare verified sender address. The app adds the Soletrade display name.
EMAIL_FROM=
# Support contact shown on the public /support page. Optional — leave blank to show a
# neutral contact line instead of a mailto link.
SUPPORT_EMAIL=

# SMS (Twilio) — optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI layer (defaults to mock — no key required for dev)
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model ids are configurable (defaults shown); opt into a newer release without a code change.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o

# Rate limiting (Phase 11a) — optional. Set both to use @upstash/ratelimit (shared across
# replicas); leave blank to fall back to the in-memory counter (dev/test only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase Storage bucket for the Files platform (Phase 11b). Create the bucket in
# your Supabase project; the server uses the service-role key (RLS is defense-in-depth).
SUPABASE_STORAGE_BUCKET=files

# Playwright E2E
# Optional: override the base URL / dev server when running E2E specs against a
# preview or already-running instance. Defaults to http://localhost:3000.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
