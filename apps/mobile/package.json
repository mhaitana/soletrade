{
  "name": "@soletrade/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:ui && pnpm test:unit",
    "check": "pnpm type-check && pnpm lint && pnpm test",
    "dev": "expo start --dev-client",
    "test:ui": "jest --runInBand --watchman=false",
    "test:unit": "vitest run",
    "test:ci": "pnpm test",
    "lint:fix": "eslint . --fix",
    "export": "expo export --platform ios --platform android"
  },
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@soletrade/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.110.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.0",
    "expo-dev-client": "~58.0.0",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-haptics": "~58.0.0",
    "expo-iap": "^3.4.9",
    "expo-image-picker": "~58.0.0",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.0",
    "expo-location": "~58.0.0",
    "expo-notifications": "~58.1.6",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.0",
    "expo-sqlite": "~58.0.0",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.0",
    "expo-widgets": "~58.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.0",
    "test-renderer": "~1.3.0",
    "typescript": "~7.0.2",
    "@soletrade/eslint-config": "workspace:*",
    "@soletrade/typescript-config": "workspace:*",
    "vitest": "^4.1.9"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.vitest\\.test\\."
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.cjs"
    ]
  }
}
